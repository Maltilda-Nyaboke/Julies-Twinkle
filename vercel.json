{
  "version": 2,
  "builds": [
    {
      "src": "barbsite/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11"
  },
  "buildCommand": "./build.sh",
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1", "headers": { "Cache-Control": "max-age=31536000" } },
    { "src": "/(.*)", "dest": "barbsite/wsgi.py" }
  ]
}
